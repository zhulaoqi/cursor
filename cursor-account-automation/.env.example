# ═══ Turnstile 求解（可选，但强烈建议配置至少一个） ═══
# CapSolver：https://dashboard.capsolver.com
CAPSOLVER_API_KEY=

# 2Captcha：https://2captcha.com
TWOCAPTCHA_API_KEY=

# ═══ 信用卡信息（必填，config.py 会校验） ═══
CARD_NUMBER=
CARD_EXP_MONTH=
CARD_EXP_YEAR=
CARD_CVV=
CARD_HOLDER=
CARD_ZIP=

# ═══ 订阅计划（可选） ═══
PLAN_NAME=Pro

# ═══ IMAP（可选，默认飞书） ═══
IMAP_HOST=imap.feishu.cn
IMAP_PORT=993

# ═══ 代理（可选，推荐住宅代理） ═══
# 格式：http://user:pass@host:port
PROXY=
