# ─── IMAP 默认配置（飞书邮箱） ───
DEFAULT_IMAP_HOST=imap.feishu.cn
DEFAULT_IMAP_PORT=993
# 轮询文件夹（兼容不同服务商：收件箱/垃圾箱命名差异）
IMAP_SEARCH_FOLDERS=INBOX,Junk,Spam

# ─── 代理（可选，强烈建议配置以降低 Cloudflare 阻断） ───
# 格式：http://user:pass@host:port 或 http://host:port
PROXY=

# ─── 并发控制 ───
BROWSER_LOGIN_CONCURRENCY=5
# 账单下载并发（单 Chromium + 多 Context 模型，建议 4~8）
INVOICE_DOWNLOAD_CONCURRENCY=8
# 账单页面同时活跃 context 上限（防止页面渲染被压垮）；<=0 表示不额外限流
INVOICE_ACTIVE_CONTEXT_LIMIT=3
API_CONCURRENCY=30
# Web 批量拉取 fetch 线程上限；0=不额外限制（默认 min(账号数, max(API*2, 20))）
WEB_FETCH_MAX_WORKERS=0

# ─── 账期净支出（单 Chromium，建议低并发）───
# 并发过高易整批 0；16GB 建议 2~3
BILLING_LEDGER_CONCURRENCY=3
# 主队列失败后进入专用重试队列并发；默认 1（不占主并发）
BILLING_LEDGER_RETRY_CONCURRENCY=1
# 空列表未确认完成时会重试（建议至少 2 次，避免 SPA 首轮未 hydrate）
BILLING_LEDGER_RETRY_TIMES=2
BILLING_LEDGER_RETRY_BACKOFF_SEC=3
# 每天北京时间 05:00 自动刷新当月净支出并写库
BILLING_LEDGER_REFRESH_ENABLE=true
BILLING_LEDGER_REFRESH_CRON=0 5 * * *
BILLING_LEDGER_REFRESH_LOCK_FILE=/tmp/cam_billing_ledger_refresh.lock

# ─── Turnstile 兜底求解器（任选其一或同时配置） ───
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# ─── 数据路径 ───
ACCOUNTS_CSV=data/accounts.csv
TOKENS_DB=data/tokens.db
EXPORTS_DIR=data/exports

# ─── 浏览器登录行为 ───
HEADLESS=true
VERIFICATION_CODE_TIMEOUT=120

# ─── BI 每日同步（StarRocks） ───
# 主库（.env）；备用库 dataeye_customer 双写在 cam/starrocks_loader.py 硬编码，停用改 BI_SYNC_DUAL_WRITE=False
BI_SYNC_ENABLE=true
BI_SYNC_DB_URL=jdbc:mysql://fe-c-70afd013dd6a6a8e-internal.starrocks.aliyuncs.com:9030/dataeye_aiboard
BI_SYNC_DB_USERNAME=pro
BI_SYNC_DB_PASSWORD=
BI_SYNC_BIZ_TZ=Asia/Shanghai
BI_SYNC_CRON=30 1 * * *
BI_SYNC_RETRY_TIMES=3
BI_SYNC_ACCOUNT_TIMEOUT_SEC=600
BI_SYNC_DB_QUERY_TIMEOUT_SEC=120
BI_SYNC_DB_CONNECT_TIMEOUT_SEC=10
BI_SYNC_DB_READ_TIMEOUT_SEC=120
BI_SYNC_DB_WRITE_TIMEOUT_SEC=120
BI_SYNC_DB_POOL_MIN_CACHED=1
BI_SYNC_DB_POOL_MAX_CACHED=4
BI_SYNC_DB_POOL_MAX_CONNECTIONS=8
BI_SYNC_DB_POOL_BLOCKING=true
BI_SYNC_DB_POOL_PING=1
BI_SYNC_DB_CONNECT_RETRY_TIMES=3
BI_SYNC_DB_CONNECT_RETRY_BACKOFF_SEC=2
BI_SYNC_BATCH_SIZE=5000
BI_SYNC_LOCK_FILE=data/cam_bi_sync.lock

# ─── 套餐/按量付费 每日定时刷新（与 BI 独立；默认每天 03:00，完成后飞书通知） ───
SPENDING_REFRESH_ENABLE=true
SPENDING_REFRESH_CRON=0 3 * * *
SPENDING_REFRESH_LOCK_FILE=/tmp/cam_spending_refresh.lock
SPENDING_REFRESH_ALERT_ENABLE=true
# 消费页批量解析并发（建议 3~4 更稳；有效并行还受 INVOICE_ACTIVE_CONTEXT_LIMIT 限制）
SPENDING_REFRESH_CONCURRENCY=4

# ─── 账期净支出 写库配置（MySQL；用于导出净支出写库功能）───
LEDGER_DB_HOST=172.30.11.103
LEDGER_DB_PORT=3306
LEDGER_DB_USER=aicoding_admin
# 与上方 BI StarRocks 是两套不同的库，不要混用密码；含 # 等特殊字符时用双引号包裹
LEDGER_DB_PASSWORD=
# 数据库名（需提前创建；表由程序自动建表）
LEDGER_DB_NAME=aicoding
LEDGER_DB_POOL_MAX_CONNECTIONS=8
LEDGER_DB_POOL_MIN_CACHED=1
LEDGER_DB_POOL_MAX_CACHED=4
LEDGER_DB_CONNECT_TIMEOUT_SEC=10
LEDGER_DB_READ_TIMEOUT_SEC=30
LEDGER_DB_WRITE_TIMEOUT_SEC=30
LEDGER_DB_CONNECT_RETRY_TIMES=3
LEDGER_DB_CONNECT_RETRY_BACKOFF_SEC=2

# ─── Cursor 用量快照采集 ───
# 是否启用用量快照任务；启用后需配置上方账期数据库密码
USAGE_SNAPSHOT_ENABLE=true
# 周期采集间隔（用于 snapshot_slot）与首次启动补采阈值，单位为小时
USAGE_PERIODIC_INTERVAL_HOURS=24
# 日常全量采集的固定本地时刻（时区同 BI_SYNC_BIZ_TZ，默认 Asia/Shanghai）
USAGE_PERIODIC_DAILY_AT=06:00
USAGE_BOOTSTRAP_STALE_HOURS=36
# 单批采集并发数
USAGE_SNAPSHOT_CONCURRENCY=10
# 周期槽位失败后的重试间隔与最大尝试次数
USAGE_PERIODIC_RETRY_MINUTES=30
USAGE_PERIODIC_MAX_ATTEMPTS_PER_SLOT=3
# 重置前扫描间隔，单位为分钟
USAGE_PRE_RESET_SCAN_INTERVAL_MIN=15
# 重置前采集窗口：起点大于目标偏移，目标偏移大于终点
USAGE_PRE_RESET_WINDOW_START_MIN=360
USAGE_PRE_RESET_TARGET_OFFSET_MIN=180
USAGE_PRE_RESET_WINDOW_END_MIN=30
# 低用量阈值百分比与账期连续性容差小时数
USAGE_LOW_THRESHOLD_PCT=30
USAGE_CYCLE_CONTINUITY_TOLERANCE_HOURS=48
# 周期任务、重置前任务及账号级锁路径
USAGE_PERIODIC_LOCK_FILE=data/cam_usage_periodic.lock
USAGE_PRE_RESET_LOCK_FILE=data/cam_usage_pre_reset.lock
USAGE_ACCOUNT_LOCK_DIR=data/usage-account-locks
# 获取账号级锁的等待上限，单位为秒；零表示不等待
USAGE_ACCOUNT_LOCK_TIMEOUT_SEC=5
# 认证熔断器的样本、失败比例、冷却时间及滑动窗口设置
USAGE_AUTH_BREAKER_MIN_SAMPLES=10
USAGE_AUTH_BREAKER_FAILURE_RATIO=0.30
USAGE_AUTH_BREAKER_COOLDOWN_MIN=30
USAGE_AUTH_BREAKER_WINDOW_SIZE=50
USAGE_AUTH_BREAKER_WINDOW_MIN=10

# ─── 告警机器人（可选） ───
ALERT_BOT_ENABLE=false
ALERT_BOT_PROVIDER=feishu
ALERT_BOT_CLIENT_ID=
ALERT_BOT_SECRET=
# 告警接收人邮箱（逗号分隔）
ALERT_TO_EMAILS=
